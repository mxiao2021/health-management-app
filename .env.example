# SQLite database used by Prisma
DATABASE_URL="file:./dev.db"

# Optional: enables AI-generated weekly plans and reviews.
# Without it the app falls back to a deterministic rule-based generator.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Shared secret for the Sunday review cron endpoint (POST /api/cron/weekly-review)
CRON_SECRET=""
